+        const grouped = commentTab === "all";
+        if (!grouped) {
+          return list.map(renderCommentItem).join("");
+        }
+
+        const groups = list.reduce((acc, comment) => {
+          const key = comment.screenTitle || comment.screenId;
+          acc[key] = acc[key] || [];
+          acc[key].push(comment);
+          return acc;
+        }, {});
