+      function renderCommentList() {
+        const list = filteredComments();
+        if (!list.length) {
+          return `<section class="comment-item"><p class="comment-text">No ${commentFilter === "resolved" ? "resolved" : "open"} comments ${commentTab === "screen" ? "on this screen" : "yet"}.</p></section>`;
+        }
