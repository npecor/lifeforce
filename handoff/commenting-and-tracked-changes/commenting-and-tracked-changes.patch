+      function filteredComments() {
+        const base = commentTab === "screen" ? comments.filter((comment) => comment.screenId === activeScreenId) : comments;
+        return base.filter((comment) => {
+          if (commentFilter === "open") return !comment.resolved;
+          if (commentFilter === "resolved") return comment.resolved;
+          return true;
+        });
+      }
+
+      function formatDate(value) {
+        return new Date(value).toLocaleString([], { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" });
+      }
